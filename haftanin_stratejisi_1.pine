//@version=6
strategy("Haftanın Stratejisi #1 - HHV/LLV Kırılım", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.02, process_orders_on_close=false, margin_long=0, margin_short=0)

// Girdiler
len       = input.int(10, "HHV/LLV Periyodu", minval=1)
allowLong = input.bool(true,  "Long işlemlere izin ver")
allowShort= input.bool(true,  "Short işlemlere izin ver")
slPct     = input.float(3.0, "Zarar Durdur (SL) %", minval=0.1, step=0.1)
tpPct     = input.float(6.0, "Kâr Al (TP) %",       minval=0.1, step=0.1)

// Önceki N barın en yüksek / en düşük seviyesi (mevcut bar hariç)
hhv = ta.highest(high, len)[1]
llv = ta.lowest(low, len)[1]

plot(hhv, "HHV", color.green, 1, plot.style_stepline)
plot(llv, "LLV", color.red,   1, plot.style_stepline)

// Pozisyon yokken (flat): stop emirle giriş. Önceki 10 barın zirvesi kırılırsa AL, dibi kırılırsa SAT
if strategy.position_size == 0
    if allowLong
        strategy.entry("AL",  strategy.long,  qty=1, stop=hhv)
    if allowShort
        strategy.entry("SAT", strategy.short, qty=1, stop=llv)
else
    // Pozisyon açıkken bekleyen giriş emirlerini iptal et (ters dönüş yok, 1 kontrat)
    strategy.cancel("AL")
    strategy.cancel("SAT")

// Çıkış: SL/TP veya karşı seviye kırılımı (hangisi önce gelirse), sonra flat
if strategy.position_size > 0
    avg = strategy.position_avg_price
    strategy.exit("AL Çıkış", "AL", stop=math.max(avg * (1 - slPct / 100), llv), limit=avg * (1 + tpPct / 100))
if strategy.position_size < 0
    avg = strategy.position_avg_price
    strategy.exit("SAT Çıkış", "SAT", stop=math.min(avg * (1 + slPct / 100), hhv), limit=avg * (1 - tpPct / 100))
